{
  "name": "settlesure",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Razorpay-style payment gateway settlement reconciliation (Rust engine)",
  "scripts": {
    "api": "cargo run -p settlesure-api",
    "api:build": "cargo build --release -p settlesure-api",
    "reconcile": "cargo run -q -p settlesure-cli --",
    "reconcile:fixtures": "cargo run -q -p settlesure-cli -- --settlement-file fixtures/real/settlements.csv --bank-file fixtures/real/bank.csv --payments-file fixtures/real/payments.csv --skip-llm",
    "reconcile:notify": "cargo run -q -p settlesure-cli -- --seed 42 --skip-llm --notify --no-banner",
    "robustness-report": "cargo run -q -p settlesure-cli -- --seed 42 --runs 20 --skip-llm",
    "generate": "cargo run -q -p settlesure-cli -- --generate-only",
    "test": "cargo test --workspace",
    "dashboard": "npm run dev --prefix dashboard",
    "check-baseline": "node scripts/check-baseline.mjs",
    "sync-report": "node scripts/sync-dashboard-report.mjs",
    "check-ablation-seeds": "node scripts/check-ablation-seeds.mjs",
    "ablation-seeds": "cargo run -p settlesure-cli -- --seed 42 --runs 5 --compare-llm --llm-provider ollama --llm-model llama3.2 --no-banner",
    "ablation-models-help": "echo 'Manual per-model ablation (not automated). Example: cargo run --release -p settlesure-cli -- --seed 42 --compare-llm --llm-provider ollama --llm-model <name> --no-llm-cache --no-banner'",
    "ablation-openai": "sh scripts/ablation-openai.sh",
    "ablation-anthropic": "sh scripts/ablation-anthropic.sh",
    "bench-throughput": "node scripts/bench-throughput.mjs --runs 5 --scales 1,10,50",
    "sweep-decoys": "RUN_SWEEP=1 cargo test -p settlesure-integration write_decoy_sweep -- --nocapture",
    "clippy": "cargo clippy --all-targets --all-features -- -D warnings"
  }
}
