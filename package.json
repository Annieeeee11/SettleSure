{
  "name": "settlesure",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Razorpay-style payment gateway settlement reconciliation (Rust engine)",
  "scripts": {
    "reconcile": "cargo run -q -p settlesure-cli --",
    "generate": "cargo run -q -p settlesure-cli -- --generate-only",
    "test": "cargo test --workspace",
    "dashboard": "npm run dev --prefix dashboard",
    "check-baseline": "node scripts/check-baseline.mjs",
    "bench-throughput": "node scripts/bench-throughput.mjs --runs 5 --scales 1,10,50",
    "sweep-decoys": "RUN_SWEEP=1 cargo test -p settlesure-integration write_decoy_sweep -- --nocapture",
    "clippy": "cargo clippy --all-targets --all-features -- -D warnings"
  }
}
